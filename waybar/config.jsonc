{
    "layer": "top",
    "position": "top",
    "height": 20,
    "margin": 0,
    "spacing": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
        // "custom/title"
    ],
    "modules-center": [],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/updates",
        "battery",
        "clock",
        "custom/power",
        "custom/gpu",
        "custom/focusd"
    ],
    "hyprland/workspaces": {
        "all-outputs": true,
        "sort-by-number": true,
        "show-special": false,
        "disable-scroll": false,
        "warp-on-scroll": false,
        "on-click": "activate",
        "format": "{windows}{icon}",
        "format-window-separator": "",
        "format-icons": {
            "empty": "",
            "default": "",
            "persistent": "",
            "visible": "",
            "active": ""
        },
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<firefox|zen-browser|librewolf>": "󰈹",
            "class<chromium|google-chrome|google-chrome-beta|google-chrome-unstable>": "",
            "class<brave-browser|brave-browser-beta>": "",
            "class<org.qutebrowser.qutebrowser>": "󰖟",
            "class<kitty>": "󰄛",
            "class<spotify": "",
            "class<Alacritty|foot|footclient|org.gnome.Console|gnome-terminal-server|org.gnome.Terminal|com.mitchellh.ghostty|wezterm-gui>": "",
            "class<code|Code|code-url-handler|codium|VSCodium|codium-url-handler>": "󰨞",
            "class<subl|sublime_text>": "󰅳",
            "class<neovide|nvim-qt>": "",
            "class<jetbrains-idea|jetbrains-idea-ce|idea>": "",
            "class<jetbrains-pycharm|pycharm>": "",
            "class<jetbrains-webstorm|webstorm>": "",
            "class<jetbrains-clion|clion>": "",
            "class<android-studio>": "󰀴",
            "class<org.gnome.Nautilus|thunar|org.kde.dolphin|nemo>": "",
            "class<discord|Discord|vesktop>": "󰙯",
            "class<Slack>": "󰒱",
            "class<TelegramDesktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "",
            "class<signal>": "󰭹",
            "class<Element>": "󰘨",
            "class<whatsapp-for-linux>": "󰖣",
            "class<[Ss]potify>": "",
            "class<vlc>": "󰕼",
            "class<mpv|org.kde.haruna|strawberry|rhythmbox|org.gnome.Totem>": "",
            "title<.*youtube.*>": "󰗃",
            "title<.*netflix.*>": "󰝆",
            "title<.*prime video.*|.*amazon.*>": "",
            "title<.*twitch.*>": "󰕃",
            "class<gimp-2.10|Gimp>": "",
            "class<org.inkscape.Inkscape|Inkscape>": "󰕙",
            "class<krita>": "",
            "class<blender>": "󰂫",
            "class<org.audacityteam.Audacity|Audacity>": "󰎈",
            "class<com.obsproject.Studio>": "",
            "class<kdenlive>": "󰕧",
            "class<steam>": "",
            "class<lutris>": "󰺵",
            "class<heroic>": "󰊖",
            "class<prismlauncher|org.prismlauncher.PrismLauncher>": "󰍳",
            "class<libreoffice-writer>": "󰈬",
            "class<libreoffice-calc>": "󰧷",
            "class<libreoffice-impress>": "󰈧",
            "class<libreoffice>": "󰈙",
            "class<thunderbird>": "",
            "class<org.gnome.Evince|evince>": "󰈦",
            "class<org.gnome.Settings|io.missioncenter.MissionCenter>": "",
            "class<nwg-look>": "",
            "class<org.gnome.SystemMonitor>": "󰄨",
            "class<pavucontrol>": "󰕾",
            "class<org.gnome.Calculator>": "󰃬",
            "class<org.gnome.Weather>": "",
            "class<org.kde.kate|org.gnome.TextEditor>": "󰈔",
            "title<.*reddit.*>": "",
            "title<.*github.*>": "",
            "class<retroarch>": "󰺵",
            "class<org.gnome.Lollypop>": "󰎆"
        }
    },
    "custom/launcher": {
        "format": "󰣇 MENU",
        "on-click": "~/.config/wofi/launcher.sh"
    },
    "custom/title": {
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/title.sh"
    },
    "cpu": {
        "format": "  {usage}%",
        "interval": 500
    },
    "memory": {
        "format": "  {percentage}%",
        "interval": 500
    },
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits",
        "format": "󰢮  GPU {}",
        "interval": 2
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤭  Offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "on-click": "kitty nmtui"
    },
    "bluetooth": {
        "format": "󰂯  {status}",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": " 󱄠 {volume}%",
        "on-click": "pavucontrol"
    },
    // "custom/updates": {
    //     "interval": 1800,
    //     "exec": "checkupdates | wc -l",
    //     "format": "󰚰 {}"
    // },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-charging": "󰂄 {capacity}%"
    },
    "clock": {
        "format": "{:%a, %d %b  %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/focusd": {
        "return-type": "json",
        "exec": "focusd status",
        "interval": 1,
        "format": "{icon} ┃ {text}",
        "format-icons": {
            "work": " › ",
            "work-paused": " › ",
            "short-break": " › ",
            "short-break-paused": " › ",
            "long-break": " › 󰒲",
            "long-break-paused": " › 󰒲"
        },
        "on-click": "focusd toggle",
        "on-click-right": "focusd next",
        "on-click-middle": "focusd reset",
        "tooltip": true
    }
}